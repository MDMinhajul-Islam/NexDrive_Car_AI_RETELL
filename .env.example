# ---------------------------------------------------------------------------
# PUBLIC values (NEXT_PUBLIC_*). Inlined into the browser bundle at BUILD time.
# In Docker/Dokploy these must be passed as Build Args, not runtime Environment.
# ---------------------------------------------------------------------------

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL, used for metadata, sitemap and robots (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key (dash.cloudflare.com > Turnstile). OPTIONAL.
# Turnstile is on only when BOTH this and TURNSTILE_SECRET_KEY are set.
# Leave both empty to run without it; the per-IP rate limit stays on either way.
# For local testing Cloudflare provides an always-pass pair:
#   site key 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# SERVER-ONLY secrets. Read at RUNTIME, never sent to the browser.
# In Docker/Dokploy these go in Environment, not Build Args.
# ---------------------------------------------------------------------------

# Shared secret between the booking Server Action and Postgres.
# Generate with: openssl rand -hex 32
# Store the same value in Supabase Vault as `website_booking_key`
# (see supabase/proposed/07_fixes.sql).
WEBSITE_BOOKING_KEY=

# Cloudflare Turnstile secret key. OPTIONAL. Empty = Turnstile is skipped and the
# widget is hidden. Set it together with NEXT_PUBLIC_TURNSTILE_SITE_KEY to enable.
TURNSTILE_SECRET_KEY=

# Retell voice agent, for the "Talk to our AI assistant" web call on the home page.
# OPTIONAL: leave both empty and the call panel says the assistant is unavailable.
# RETELL_API_KEY is a secret API key from the Retell dashboard (not a public key).
# RETELL_AGENT_ID is the agent the website should call, for example agent_xxxxxxxx.
# Each call is billed by Retell; the route is rate limited to 3 calls per IP per 10 minutes.
RETELL_API_KEY=
RETELL_AGENT_ID=

# Set to true ONLY when the site is behind Cloudflare. It makes the rate limiter trust
# the CF-Connecting-IP header for the visitor's address. Leave unset otherwise.
TRUST_CLOUDFLARE_IP=

# Optional, for `npm run check:responsive` only. A test admin account lets the script
# screenshot and audit the admin pages. Without these the admin part is skipped.
# Never use a real staff account here.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
